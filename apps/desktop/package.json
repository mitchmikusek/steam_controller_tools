{
  "name": "steam-controller-flash-tool",
  "version": "1.0.0",
  "description": "Flash BLE firmware onto the original Steam Controller (2015)",
  "author": "Mitch Mikusek",
  "license": "GPL-2.0-only",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:dir": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "tools.steamcontroller.flash",
    "productName": "Steam Controller Flash Tool",
    "icon": "icon.png",
    "files": ["main.js", "preload.js", "ui/**/*"],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility",
      "icon": "icon.png"
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.utilities",
      "icon": "icon.icns"
    },
    "win": {
      "target": ["nsis"],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false
    }
  }
}
