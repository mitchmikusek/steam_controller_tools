{
  "name": "steam-controller-flash-tool",
  "version": "1.0.0",
  "description": "Flash BLE firmware onto the original Steam Controller (2015)",
  "author": {
    "name": "Mitch Mikusek",
    "email": "mitchmikusek@users.noreply.github.com"
  },
  "license": "GPL-2.0-only",
  "homepage": "https://steamcontroller.tools",
  "repository": "github:mitchmikusek/steam_controller_tools",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:dir": "electron-builder --dir"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^42.0.0-beta.8",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "publish": {
      "provider": "github"
    },
    "appId": "tools.steamcontroller.flash",
    "productName": "Steam Controller Flash Tool",
    "icon": "icon.png",
    "files": [
      "main.js",
      "preload.js",
      "ui/**/*",
      "icon.*"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities",
      "icon": "icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.ico",
      "publisherName": "Mitch Mikusek"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false
    }
  }
}
